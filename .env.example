# Copy to .env.local and fill in real values. .env.local is gitignored.
# NEVER paste real secrets into this file or commit .env.local.

# Postgres connection string (Supabase / Neon)
DATABASE_URL=

# Groq API key (free) — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase Auth — owner dashboard login (email + password).
# Local values come from `supabase status` (URL + anon/service_role keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Demo owner is seeded by `npm run db:seed` (demo@brightsmile.test / demo1234).

# Resend — owner email alerts on new appointment / lead
RESEND_API_KEY=
